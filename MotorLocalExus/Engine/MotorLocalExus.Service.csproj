<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework><RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><PlatformTarget>x64</PlatformTarget>
    <AssemblyName>MotorLocalExus.Service</AssemblyName><Version>2.2.0</Version>
    <Product>HEXODUS BioSync</Product><Company>HEXODUS</Company>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <Reference Include="DPUruNet"><HintPath>DPUruNet.dll</HintPath></Reference>
    <None Update="DPUruNet.dll"><CopyToOutputDirectory>Always</CopyToOutputDirectory></None>
    <Compile Include="../Shared/*.cs" Link="Shared/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
